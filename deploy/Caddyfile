{$SITE_ADDRESS} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy backend:4000
	}

	@uploads path /uploads/*
	handle @uploads {
		reverse_proxy backend:4000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Browser-facing S3 endpoint used in presigned PUT/GET URLs. The MinIO Console
# remains internal and is intentionally not routed here.
{$S3_ADDRESS} {
	reverse_proxy minio:9000
}

