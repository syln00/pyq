# ===== 运行环境 =====
NODE_ENV=production
PORT=4000

# ===== MySQL 数据库 =====
# 手动部署: 127.0.0.1
# Docker Compose: mysql (对应 docker-compose.yml 中的 service 名)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kanle
DB_PASSWORD=change-me
DB_NAME=moment_blog

# ===== JWT 认证 =====
# 生产环境务必改为随机长字符串（建议 32+ 字符）
JWT_SECRET=please-generate-a-long-random-string
JWT_EXPIRES_IN=7d
# 生产 HTTPS 保持 true；仅本机纯 HTTP Docker 测试时设为 false。
# SESSION_COOKIE_SECURE=true

# ===== 初始管理员（仅首次 seed 创建时生效）=====
# 注意：管理员创建后，修改 ADMIN_PASSWORD 不会更新已有账号
# 重置密码请运行: node dist/scripts/reset-password.js
ADMIN_EMAIL=admin@kanle.net
ADMIN_PASSWORD=123456
ADMIN_USERNAME=admin

# ===== 前端地址（用于 CORS 跨域 + 按需 revalidate 回调）=====
# 生产环境填你的真实域名，如 https://yourdomain.com
CLIENT_URL=http://localhost:3000
# 多个允许来源可用逗号分隔；未设置时沿用 CLIENT_URL。
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ===== 按需重验证密钥 =====
# 须与前端 REVALIDATE_SECRET / NEXT_PUBLIC_REVALIDATE_SECRET 保持一致
# 作用：发动态/评论后触发前端页面即时刷新
REVALIDATE_SECRET=kanle-revalidate

# ===== 定时豆瓣同步 =====
# Vercel Cron / 外部调度器请求 /api/douban/cron-sync 的 Bearer 密钥
CRON_SECRET=please-generate-a-long-random-cron-secret

# ===== Vercel Serverless 部署专用 =====
# 应用启动默认只验证连接，不会自动执行 DDL。正式部署请先在受信任的
# 本地/CI/维护环境运行 `npm run db:init`。只有兼容旧部署时才临时设置：
# DB_SYNC_ON_BOOT=true

# 数据库连接池（不填则按是否 Serverless 自动取默认值：Serverless 2 / 传统部署 10）
# DB_POOL_MAX=2
# DB_POOL_IDLE=5000

# 大多数托管 MySQL（PlanetScale / TiDB Serverless / 阿里云 RDS 外网连接等）要求 TLS
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# ===== 私有 S3 兼容对象存储（MinIO / Cloudflare R2 / NAS S3）=====
STORAGE_DRIVER=s3
# 后端访问地址。Compose 内的 MinIO 使用 http://minio:9000；R2 使用
# https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://127.0.0.1:9000
# 浏览器预签名直传地址，必须是浏览器可访问的 HTTPS 域名。
S3_PRESIGN_ENDPOINT=https://s3.yourdomain.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pyq-minio
S3_SECRET_ACCESS_KEY=change-this-minio-secret
S3_BUCKET=pyq-media
# MinIO / 大多数 NAS S3 填 true；R2 填 false。
S3_FORCE_PATH_STYLE=true
S3_SIGNED_GET_TTL_SECONDS=300

# Bucket 必须保持私有。浏览器直传需要允许站点 Origin 的 PUT/HEAD CORS。
# 旧 R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET /
# R2_ENDPOINT 仍兼容一个版本，但启动时会输出弃用提示。
