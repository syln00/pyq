# Copy this file to .env before running Docker Compose.
# Local test values use plain HTTP. For a public deployment, use the HTTPS
# example below and set SESSION_COOKIE_SECURE=true.
SITE_ADDRESS=http://localhost
SITE_URL=http://localhost
S3_ADDRESS=http://s3.localhost
SESSION_COOKIE_SECURE=false

# Public HTTPS example:
# SITE_ADDRESS=pyq.example.com
# SITE_URL=https://pyq.example.com
# S3_ADDRESS=s3.pyq.example.com
# SESSION_COOKIE_SECURE=true

MYSQL_DATABASE=moment_blog
MYSQL_USER=pyq
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

MINIO_ROOT_USER=pyq-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password

# Application storage. These defaults point to the bundled private MinIO.
# To migrate to R2 or NAS S3, keep object keys unchanged and replace only this
# block, then restart backend/frontend.
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=http://s3.localhost
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pyq-minio
S3_SECRET_ACCESS_KEY=replace-with-a-long-minio-password
S3_BUCKET=pyq-media
S3_FORCE_PATH_STYLE=true
S3_SIGNED_GET_TTL_SECONDS=300

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
REVALIDATE_SECRET=replace-with-a-random-revalidate-secret
CRON_SECRET=replace-with-a-random-cron-secret

# Optional image overrides. Pin exact versions for long-lived production hosts.
MYSQL_IMAGE=mysql:8.4
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest
CADDY_IMAGE=caddy:2.10-alpine
